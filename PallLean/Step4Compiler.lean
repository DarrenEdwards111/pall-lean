        hM_timeBound
        (le_trans hM_numStates (le_refl _))).totalDegree <
          Nat.log 2 ((2 : ℕ) ^ 804)) :
    P ≠ NP :=
  P_ne_NP_paper_faithful_kernel_only_parametric hdeg

