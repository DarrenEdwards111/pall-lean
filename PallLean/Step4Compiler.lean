        (PaperFaithfulCompilation.cookLevinUVSplit M n)
        (cookLevinQ_SoS M n hn2 htb hns) := by
  unfold Q_times_Phi_135 Phi_SoS z_SoS V_SoS
  rw [Fin.prod_univ_one]
