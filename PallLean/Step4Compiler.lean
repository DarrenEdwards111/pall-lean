theorem P_eq_NP_implies_False_kernel_only
    (hdeg : ∀ (M : TuringMachine.DTM)
      (hM_numStates : M.numStates ≤ (2 : ℕ) ^ 804)
      (hM_timeBound : M.timeBound ≤ 4),
      (PaperFaithfulCompilation.cookLevinQ M ((2 : ℕ) ^ 804)
