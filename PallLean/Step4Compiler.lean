    (cT cG : ℕ)
    (trace_layers batcher_layers : List
      (MvPolynomial
        (Fin (PaperFaithfulSeparation.cook_levin_compilation
          M n hn2 htb hns).numVars) ℚ))
    (sos_layers : List
      (SoSGadget
        (PaperFaithfulSeparation.cook_levin_compilation
