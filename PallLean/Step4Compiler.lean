        (fun c => MvPolynomial.rename e (z c))
        (fun c => MvPolynomial.rename e (V c)) := by
  unfold Q_times_Phi_135
  rw [map_prod]
  apply Finset.prod_congr rfl
  intro c _
  rw [map_sub, map_one, map_mul, map_pow]

