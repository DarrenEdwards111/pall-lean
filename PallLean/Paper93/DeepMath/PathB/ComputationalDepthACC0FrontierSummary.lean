    (∀ p ∈ S, (ACC0CRTGatePolys.modPGate p).totalDegree ≤ p - 1)
      ∧ ((∀ p ∈ S, MvPolynomial.eval (fun _ => (s : ZMod p)) (ACC0CRTGatePolys.modPGate p) = 1)
          ↔ (∏ p ∈ S, p) ∣ s) :=
