    3 * Fintype.card Seed ≤ 4 * (Finset.univ.filter (fun σ => ¬ circuitWrong x σ)).card :=
  ACC0RSPointwiseComposition.circuit_perpoint_3_4 gateWrong circuitWrong M hcomp hgate hbound x

