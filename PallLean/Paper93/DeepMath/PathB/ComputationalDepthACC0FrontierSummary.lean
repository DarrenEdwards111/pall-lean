theorem nw_scanTransFrom_run_frontier (base : ℕ) (t : ACC0ConcreteNTM.TMTrans) (pre rest : List Bool) :
    ∃ tp', ACC0NTM.reachIn (ACC0ConcreteNTM.toNTM (ACC0UniversalTMScanTransFrom.scanTransFrom base))
