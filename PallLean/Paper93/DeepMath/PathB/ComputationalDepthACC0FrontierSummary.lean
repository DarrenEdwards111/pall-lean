theorem rs_agreement_BT_frontier (p t : ℕ) [Fact p.Prime] {n : ℕ} (ht : 1 ≤ t) (C : BoolCircuitSyntax n)
    (hmod : ∀ q r cs, (BoolCircuitSyntax.modGate q r cs : BoolCircuitSyntax n) ∈ Layer3.subcircuits C → q = p) :
    ∃ ω : Layer3.FormSpace p t C,
