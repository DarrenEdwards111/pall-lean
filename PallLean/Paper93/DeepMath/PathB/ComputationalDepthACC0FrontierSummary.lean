                (Layer3.toAgree p t (Layer3.oracleOf p t C ω) C)
              ≠ Layer3.boolToZMod p (C.eval x))).card * p ^ t
          ≤ (Layer3.subcircuits C).toFinset.card * Fintype.card (Fin n → Bool) :=
  ACC0RSAgreementBound.rs_agreement_BT p t ht C hmod

