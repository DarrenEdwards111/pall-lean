import PallLean.Paper93.DeepMath.PathB.ComputationalDepthCrossBranchAffineFactorization

/-!
# The exact coset-collision condition for cross-branch parity reuse

The correct residual classifier sends a queried-branch shift to its coset modulo the span generated by the kept
input columns.  This file identifies equality of residual classes exactly: shifts `a` and `b` collide iff `a-b` lies
in the kept span.

It also proves the first constructive collision lemma.  If a nonzero queried column already lies in the kept span,
then the branches selecting and not selecting that column yield the same residual coset, hence the cross-branch class
family is strictly smaller than the reachable shift family.
-/

namespace PallLean.Paper93.DeepMath.PathB.CrossBranchCosetCollision

open scoped Classical
open Finset
open PallLean.Paper93.DeepMath.PathB.CrossBranchAffineFactorization

variable {F V : Type*} [Field F] [AddCommGroup V] [Module F V] [DecidableEq V]

/-- Reachable queried shifts classified modulo the kept-column span. -/
noncomputable def cosetClassSet (kept queried : Finset V) :
    Finset (V ⧸ Submodule.span F (↑kept : Set V)) :=
  affineClassSet queried (Submodule.mkQ (Submodule.span F (↑kept : Set V)))

/-- **Exact cross-branch collision criterion (proved).** -/
theorem coset_eq_iff_sub_mem_keptSpan (kept : Finset V) (a b : V) :
    Submodule.mkQ (Submodule.span F (↑kept : Set V)) a =
        Submodule.mkQ (Submodule.span F (↑kept : Set V)) b ↔
      a - b ∈ Submodule.span F (↑kept : Set V) := by
  exact Submodule.Quotient.eq (R := F) (p := Submodule.span F (↑kept : Set V))

/-- The zero shift is always reachable (the all-zero queried assignment). -/
theorem zero_mem_branchShiftSet (queried : Finset V) : 0 ∈ branchShiftSet queried := by
  unfold branchShiftSet
  apply Finset.mem_image.mpr
  exact ⟨∅, Finset.mem_powerset.mpr (Finset.empty_subset queried), by simp⟩

/-- Each queried generator is itself a reachable shift (select that coordinate only). -/
theorem mem_branchShiftSet_of_mem {queried : Finset V} {v : V} (hv : v ∈ queried) :
    v ∈ branchShiftSet queried := by
  unfold branchShiftSet
  apply Finset.mem_image.mpr
  refine ⟨{v}, Finset.mem_powerset.mpr ?_, by simp⟩
  simpa using hv

/-- **Redundant queried column ⇒ strict cross-branch reuse (proved).**  A nonzero queried vector already generated
by kept columns makes the zero and singleton branches land in the same residual coset. -/
theorem strict_coset_reuse_of_mem_keptSpan (kept queried : Finset V) {v : V}
    (hvq : v ∈ queried) (hv0 : v ≠ 0) (hvK : v ∈ Submodule.span F (↑kept : Set V)) :
    (cosetClassSet (F := F) kept queried).card < (branchShiftSet queried).card := by
  apply affineClassSet_card_lt_of_collision queried
    (Submodule.mkQ (Submodule.span F (↑kept : Set V)))
    (mem_branchShiftSet_of_mem hvq) (zero_mem_branchShiftSet queried) hv0
  rw [coset_eq_iff_sub_mem_keptSpan]
  simpa using hvK

end PallLean.Paper93.DeepMath.PathB.CrossBranchCosetCollision

#print axioms PallLean.Paper93.DeepMath.PathB.CrossBranchCosetCollision.coset_eq_iff_sub_mem_keptSpan
#print axioms PallLean.Paper93.DeepMath.PathB.CrossBranchCosetCollision.strict_coset_reuse_of_mem_keptSpan
