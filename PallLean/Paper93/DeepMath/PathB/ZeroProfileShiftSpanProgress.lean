import PallLean.Paper93.DeepMath.PathB.FixedProfileZeroHistogram

/-!
# Zero-profile shifted-span progress

This file makes the remaining zero-profile shifted-base-product blocker more
concrete.  The family

`zeroProfileShiftImageSet κ factors`

is generated by `mlProj (shift * ∏ factors)` while `shift.vars` is contained in
some derivative list support `S.toFinset` with `S.length ≤ κ`.  We show that
every such generator lies in the span of an explicit finite monomial family:
for every variable support `T` with `T.card ≤ κ`, take multilinear monomials
on `T ∪ (∏ factors).vars`.

The final theorems package this finite support-basis reduction as sufficient
input for the existing zero-histogram common-span and template-collapse
frontiers from `FixedProfileZeroHistogram.lean`.
-/

namespace PallLean
namespace Paper93
namespace DeepMath
namespace PathB

open MvPolynomial SymmetricPowerBound TuringMachine PaperFaithfulSeparation
open WithinProfileBound MultilinearSPDP SPDP
open scoped BigOperators

attribute [local instance] Classical.dec

/-- Variables of the unshifted zero-profile base product `∏ factors`. -/
noncomputable def zeroProfileBaseProductVars {n L : ℕ}
    (factors : Fin L → MvPolynomial (Fin n) ℚ) : Finset (Fin n) :=
  (Finset.univ.prod factors).vars

/-- A finite monomial family that covers the variable supports of the
zero-profile shifted base-product image.  It ranges over all shift supports
`T` of cardinality at most `κ`, then takes multilinear monomials on
`T ∪ (∏ factors).vars`. -/
noncomputable def zeroProfileShiftSupportBasis {n L : ℕ}
    (κ : ℕ)
    (factors : Fin L → MvPolynomial (Fin n) ℚ) :
    Finset (MvPolynomial (Fin n) ℚ) :=
  (((Finset.univ : Finset (Fin n)).powerset.filter
      (fun T : Finset (Fin n) => T.card ≤ κ)).biUnion
    (fun T => MlProjFar.mlMonomialBasis
      (T ∪ zeroProfileBaseProductVars factors)))

/-- A concrete cardinality upper bound for
`zeroProfileShiftSupportBasis`: sum the size bounds `2^|T ∪ baseVars|` over
all admissible shift supports `T`. -/
noncomputable def zeroProfileShiftSupportBasisCardBound {n L : ℕ}
    (κ : ℕ)
    (factors : Fin L → MvPolynomial (Fin n) ℚ) : ℕ :=
  (((Finset.univ : Finset (Fin n)).powerset.filter
      (fun T : Finset (Fin n) => T.card ≤ κ)).sum
    (fun T => 2 ^ (T ∪ zeroProfileBaseProductVars factors).card))

/-- The explicit support basis has cardinality at most the concrete sum bound
`zeroProfileShiftSupportBasisCardBound`. -/
theorem zeroProfileShiftSupportBasis_card_le_cardBound {n L : ℕ}
    (κ : ℕ)
    (factors : Fin L → MvPolynomial (Fin n) ℚ) :
    (zeroProfileShiftSupportBasis κ factors).card ≤
      zeroProfileShiftSupportBasisCardBound κ factors := by
  unfold zeroProfileShiftSupportBasis zeroProfileShiftSupportBasisCardBound
  let A : Finset (Finset (Fin n)) :=
    (Finset.univ : Finset (Fin n)).powerset.filter
      (fun T : Finset (Fin n) => T.card ≤ κ)
  change
    (A.biUnion
      (fun T => MlProjFar.mlMonomialBasis
        (T ∪ zeroProfileBaseProductVars factors))).card ≤
      A.sum (fun T => 2 ^ (T ∪ zeroProfileBaseProductVars factors).card)
  exact le_trans Finset.card_biUnion_le (by
    apply Finset.sum_le_sum
    intro T _hT
    exact MlProjFar.mlMonomialBasis_card
      (T ∪ zeroProfileBaseProductVars factors))

/-- A single shifted zero-profile base product uses only shift variables and
variables already present in the base product. -/
theorem zeroProfileShiftedBase_vars_subset {n L : ℕ}
    (factors : Fin L → MvPolynomial (Fin n) ℚ)
    (S : List (Fin n))
    (shift : MvPolynomial (Fin n) ℚ)
    (hshift : shift.vars ⊆ S.toFinset) :
    (mlProj (shift * Finset.univ.prod factors)).vars ⊆
      S.toFinset ∪ zeroProfileBaseProductVars factors := by
  calc
    (mlProj (shift * Finset.univ.prod factors)).vars
        ⊆ (shift * Finset.univ.prod factors).vars :=
          vars_mlProj_subset _
    _ ⊆ shift.vars ∪ (Finset.univ.prod factors).vars :=
          MvPolynomial.vars_mul shift (Finset.univ.prod factors)
    _ ⊆ S.toFinset ∪ zeroProfileBaseProductVars factors := by
          intro v hv
          rw [Finset.mem_union] at hv ⊢
          cases hv with
          | inl hv_shift =>
              exact Or.inl (hshift hv_shift)
          | inr hv_base =>
              exact Or.inr (by
                simpa [zeroProfileBaseProductVars] using hv_base)

/-- Membership in the zero-profile shift image carries an explicit variable
support witness of size at most `κ`, up to the fixed base-product variables. -/
theorem zeroProfileShiftImageSet_member_vars_subset {n L : ℕ}
    (κ : ℕ)
    (factors : Fin L → MvPolynomial (Fin n) ℚ)
    (p : MvPolynomial (Fin n) ℚ)
    (hp : p ∈ zeroProfileShiftImageSet κ factors) :
    ∃ S : List (Fin n),
      S.length ≤ κ ∧
      p.vars ⊆ S.toFinset ∪ zeroProfileBaseProductVars factors := by
  simp only [zeroProfileShiftImageSet, Set.mem_iUnion,
    Set.mem_singleton_iff] at hp
  rcases hp with ⟨S, hS, shift, hshift, hp_eq⟩
  refine ⟨S, hS, ?_⟩
  rw [hp_eq]
  exact zeroProfileShiftedBase_vars_subset factors S shift hshift

/-- The zero-profile shifted-base-product image is contained in the span of
the explicit finite support basis `zeroProfileShiftSupportBasis`. -/
theorem zeroProfileShiftImageSet_subset_supportBasis_span {n L : ℕ}
    (κ : ℕ)
    (factors : Fin L → MvPolynomial (Fin n) ℚ) :
    zeroProfileShiftImageSet κ factors ⊆
      Submodule.span ℚ
        (↑(zeroProfileShiftSupportBasis κ factors) :
          Set (MvPolynomial (Fin n) ℚ)) := by
  intro p hp
  simp only [zeroProfileShiftImageSet, Set.mem_iUnion,
    Set.mem_singleton_iff] at hp
  rcases hp with ⟨S, hS, shift, hshift, hp_eq⟩
  rw [hp_eq]
  have hS_card : S.toFinset.card ≤ κ :=
    (List.toFinset_card_le S).trans hS
  have hbasis_subset :
      (↑(MlProjFar.mlMonomialBasis
          (S.toFinset ∪ zeroProfileBaseProductVars factors)) :
          Set (MvPolynomial (Fin n) ℚ)) ⊆
        (↑(zeroProfileShiftSupportBasis κ factors) :
          Set (MvPolynomial (Fin n) ℚ)) := by
    intro q hq
    change q ∈ zeroProfileShiftSupportBasis κ factors
    unfold zeroProfileShiftSupportBasis
    exact Finset.mem_biUnion.mpr
      ⟨S.toFinset,
        Finset.mem_filter.mpr
          ⟨Finset.mem_powerset.mpr (Finset.subset_univ S.toFinset),
            hS_card⟩,
        by simpa using hq⟩
  have hsmall :
      mlProj (shift * Finset.univ.prod factors) ∈
        Submodule.span ℚ
          (↑(MlProjFar.mlMonomialBasis
            (S.toFinset ∪ zeroProfileBaseProductVars factors)) :
            Set (MvPolynomial (Fin n) ℚ)) := by
    apply MlProjFar.mlProj_in_span_of_vars_subset
    · exact fun α hα => isMultilinear_of_mem_mlProj_support _ α hα
    · exact zeroProfileShiftedBase_vars_subset factors S shift hshift
  exact (Submodule.span_mono hbasis_subset) hsmall

/-- Span-level form of
`zeroProfileShiftImageSet_subset_supportBasis_span`. -/
theorem zeroProfileShiftImageSpan_le_supportBasis_span {n L : ℕ}
    (κ : ℕ)
    (factors : Fin L → MvPolynomial (Fin n) ℚ) :
    Submodule.span ℚ (zeroProfileShiftImageSet κ factors) ≤
      Submodule.span ℚ
        (↑(zeroProfileShiftSupportBasis κ factors) :
          Set (MvPolynomial (Fin n) ℚ)) := by
  exact Submodule.span_le.mpr
    (zeroProfileShiftImageSet_subset_supportBasis_span κ factors)

/-- Concrete sufficient reduction for the zero-histogram common-span blocker:
it is enough to bound the explicit support basis by `withinProfileBound`. -/
theorem cookLevinZeroHistogramShiftCommonSpan_of_supportBasis_card_le
    (M : DTM) (n : ℕ) (hn : n ≥ 2)
    (htb : M.timeBound ≤ 4) (hns : M.numStates ≤ n)
    (hcard :
      (zeroProfileShiftSupportBasis (Nat.log 2 n)
        (fun i => (cookLevinFactorList M n hn htb hns).get i)).card
        ≤ withinProfileBound (Nat.log 2 n)) :
    CookLevinZeroHistogramShiftCommonSpan M n hn htb hns := by
  refine ⟨zeroProfileShiftSupportBasis (Nat.log 2 n)
      (fun i => (cookLevinFactorList M n hn htb hns).get i),
    hcard, ?_⟩
  exact zeroProfileShiftImageSet_subset_supportBasis_span
    (Nat.log 2 n)
    (fun i => (cookLevinFactorList M n hn htb hns).get i)

/-- Concrete-sum sufficient reduction for the zero-histogram common-span
blocker: it is enough to bound `zeroProfileShiftSupportBasisCardBound`. -/
theorem cookLevinZeroHistogramShiftCommonSpan_of_supportBasisCardBound_le
    (M : DTM) (n : ℕ) (hn : n ≥ 2)
    (htb : M.timeBound ≤ 4) (hns : M.numStates ≤ n)
    (hbound :
      zeroProfileShiftSupportBasisCardBound (Nat.log 2 n)
        (fun i => (cookLevinFactorList M n hn htb hns).get i)
        ≤ withinProfileBound (Nat.log 2 n)) :
    CookLevinZeroHistogramShiftCommonSpan M n hn htb hns :=
  cookLevinZeroHistogramShiftCommonSpan_of_supportBasis_card_le
    M n hn htb hns
    ((zeroProfileShiftSupportBasis_card_le_cardBound (Nat.log 2 n)
      (fun i => (cookLevinFactorList M n hn htb hns).get i)).trans hbound)

/-- P-side zero-profile common-span closure from the finite support-basis
cardinality bound. -/
theorem cookLevinAllBoundedProfileCommonSpanAtProfile_zero_of_supportBasis_card_le
    (M : DTM) (n : ℕ) (hn : n ≥ 2)
    (htb : M.timeBound ≤ 4) (hns : M.numStates ≤ n)
    (hcard :
      (zeroProfileShiftSupportBasis (Nat.log 2 n)
        (fun i => (cookLevinFactorList M n hn htb hns).get i)).card
        ≤ withinProfileBound (Nat.log 2 n)) :
    CookLevinAllBoundedProfileCommonSpanAtProfile
      M n hn htb hns zeroProfileHistogram :=
  cookLevinAllBoundedProfileCommonSpanAtProfile_zero_of_shiftCommonSpan
    M n hn htb hns
    (cookLevinZeroHistogramShiftCommonSpan_of_supportBasis_card_le
      M n hn htb hns hcard)

/-- Template-collapse sufficient reduction from the same finite support basis:
if the support basis itself has zero-profile template size, it witnesses the
template shifted collapse. -/
theorem cookLevinZeroHistogramTemplateShiftCollapse_of_supportBasis_card_le
    (M : DTM) (n : ℕ) (hn : n ≥ 2)
    (htb : M.timeBound ≤ 4) (hns : M.numStates ≤ n)
    (hcard :
      (zeroProfileShiftSupportBasis (Nat.log 2 n)
        (fun i => (cookLevinFactorList M n hn htb hns).get i)).card
        ≤ profileTemplateBound zeroProfileHistogram) :
    CookLevinZeroHistogramTemplateShiftCollapse M n hn htb hns := by
  refine ⟨zeroProfileShiftSupportBasis (Nat.log 2 n)
      (fun i => (cookLevinFactorList M n hn htb hns).get i),
    hcard, ?_⟩
  exact zeroProfileShiftImageSet_subset_supportBasis_span
    (Nat.log 2 n)
    (fun i => (cookLevinFactorList M n hn htb hns).get i)

/-- Singleton/template-collapse closure from a `card ≤ 1` support-basis bound,
using `profileTemplateBound zeroProfileHistogram = 1`. -/
theorem cookLevinProfileTemplateCollapseAtProfile_zero_of_supportBasis_card_le_one
    (M : DTM) (n : ℕ) (hn : n ≥ 2)
    (htb : M.timeBound ≤ 4) (hns : M.numStates ≤ n)
    (hcard :
      (zeroProfileShiftSupportBasis (Nat.log 2 n)
        (fun i => (cookLevinFactorList M n hn htb hns).get i)).card ≤ 1) :
    CookLevinProfileTemplateCollapseAtProfile
      M n hn htb hns zeroProfileHistogram := by
  apply cookLevinProfileTemplateCollapseAtProfile_zero_of_templateShiftCollapse
  apply cookLevinZeroHistogramTemplateShiftCollapse_of_supportBasis_card_le
  simpa [profileTemplateBound_zeroProfileHistogram] using hcard

