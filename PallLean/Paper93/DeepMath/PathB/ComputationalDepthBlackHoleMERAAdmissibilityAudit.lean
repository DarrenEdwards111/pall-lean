#print axioms PallLean.Paper93.DeepMath.PathB.BlackHoleMERAAdmissibilityAudit.oracleLoadedTrace_refutes_linearPrecision
#print axioms PallLean.Paper93.DeepMath.PathB.BlackHoleMERAAdmissibilityAudit.forcingLaw_rejects_oracleLoadedTrace
#print axioms PallLean.Paper93.DeepMath.PathB.BlackHoleMERAAdmissibilityAudit.exact_isometric_admissibility_cannot_force_precision
