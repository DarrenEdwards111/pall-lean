#print axioms paperScale_normalizedTransformedLeibnizRowSpan_of_polynomialSpan
#print axioms paperScale_factoredRowSpanClassifierOneZero_of_polynomialSpan_and_generatorPullback

end PallLean.Paper93.DeepMath.PathC
