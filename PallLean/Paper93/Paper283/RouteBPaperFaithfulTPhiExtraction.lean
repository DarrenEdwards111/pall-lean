/-- Membership in one letter basis injects into the seeded fold. -/
theorem routeBPaperFaithfulTPhi_mem_seededFoldedUnion_of_mem
    {α β : Type} [DecidableEq β]
    (w : List α) (B₀ : Finset β) (B : α → Finset β)
