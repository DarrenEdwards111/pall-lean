/-- The corrected paper ambient cover is equivalent to its generator form. -/
theorem routeBPaperFaithfulTPhi_strictPaperAmbientGlobalProfileSpanCover_iff_generatorCover
    {M : DTM} {n : ℕ} {hn2 : n ≥ 2}
    {htb : M.timeBound ≤ 4} {hns : M.numStates ≤ n}
