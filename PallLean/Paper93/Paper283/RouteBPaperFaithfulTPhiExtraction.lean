    RouteBPaperFaithfulTPhiRangePWindowRestrictedSingletonQuotientDerivativeFixed
        M n hn2 htb hns := by
  classical
  intro S' shift hSlen hshiftDegree hshiftVars hadm
  let p : MvPolynomial (Fin n) ℚ :=
