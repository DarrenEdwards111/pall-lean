      (routeBPaperFaithfulTPhi_strictSourceEventWordDistrib
        (routeBPaperFaithfulTPhi_strictSourceLeibnizEventWordOfGeneratorWord
          M n hn2 htb hns
          (routeBPaperFaithfulTPhi_strictSourceLeibnizTraceNFOfWord
