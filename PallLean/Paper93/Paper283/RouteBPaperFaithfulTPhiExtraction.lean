        (routeBPaperFaithfulTPhiStrictRawWindowOf n S' shift α) hrow.1
    have hlocal := D.sourceRow_mem_localTypeSpace
      ρ S' shift α hSlen hshiftDegree hshiftVars hadm hrow rfl
    have hcompressed :
