          let q : MvPolynomial (Fin n) ℚ :=
            mlProj
              (MvPolynomial.rename (cookLevinStrictFOBFlatMap n) shift *
                cookLevinZeroProfileBaseProduct M n hn2 htb hns)
          MvPolynomial.coeff α
