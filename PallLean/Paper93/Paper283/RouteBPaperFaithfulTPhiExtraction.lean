theorem routeBPaperFaithfulTPhi_strictSourceLeibnizEventWordOfTraceStepMap
    (M : DTM) (n : ℕ) (hn2 : n ≥ 2)
    (htb : M.timeBound ≤ 4) (hns : M.numStates ≤ n)
