  have hq :=
    zeroProfileSingletonNormalFormProjection_coeff factors q α
  have hd :=
    zeroProfileSingletonNormalFormProjection_coeff factors d α
  rw [hq, hd] at hrow
  simpa [factors, p, r, q, d] using hrow

