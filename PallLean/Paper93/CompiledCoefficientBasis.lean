theorem firstLocalX_mem_interfaceSpace_compiledBasis_adjacency
    {N : ℕ} (B : BlockPartition N) (κ ℓ : ℕ) (hN : 0 < N) :
    MvPolynomial.X ⟨0, hN⟩ ∈
      interfaceSpace_compiledBasis B κ ℓ ConstraintType.adjacency := by
