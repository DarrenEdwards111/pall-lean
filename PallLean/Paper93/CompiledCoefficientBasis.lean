theorem secondLocalX_mem_interfaceSpace_compiledBasis_transitionLeft
    {N : ℕ} (B : BlockPartition N) (κ ℓ : ℕ) (hN : 1 < N) :
    MvPolynomial.X ⟨1, hN⟩ ∈
