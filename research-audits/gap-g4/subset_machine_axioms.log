SubsetMachine.decides_append_false : ∀ (M : PallLean.Paper93.DeepMath.PathB.ComposableMachine.Machine)
  (lang : List Bool → Bool) (T : ℕ → ℕ),
  PallLean.Paper93.DeepMath.PathB.ComposableMachine.Decides M lang T →
    ∀ (x : List Bool), lang (x ++ [Bool.false]) = lang x
SubsetMachine.cont_decides : PallLean.Paper93.DeepMath.PathB.ComposableMachine.Decides SubsetMachine.contMachine
  SubsetMachine.contLang fun L => L + 3
