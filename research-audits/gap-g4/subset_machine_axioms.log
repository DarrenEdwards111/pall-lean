SubsetMachine.no_decider_has_easyEven_char : ∀ (κ : ℕ),
  ¬∃ M T lang,
      PallLean.Paper93.DeepMath.PathB.ComposableMachine.Decides M lang T ∧
        ∀ (m : ℕ), GodMoveSATSourceCanonicity.languageCharacteristic lang (m + m) = G4SATLink.easyEven (m + m) m κ ⋯
SubsetMachine.no_decider_has_easyEven_char_family : ∀ (κf : ℕ → ℕ) (m₁ : ℕ),
  1 ≤ m₁ →
    κf m₁ ≤ m₁ →
      ¬∃ M T lang,
          PallLean.Paper93.DeepMath.PathB.ComposableMachine.Decides M lang T ∧
            GodMoveSATSourceCanonicity.languageCharacteristic lang (m₁ + m₁) =
                G4SATLink.easyEven (m₁ + m₁) m₁ (κf m₁) ⋯ ∧
              GodMoveSATSourceCanonicity.languageCharacteristic lang (m₁ + m₁ + (m₁ + m₁)) =
                G4SATLink.easyEven (m₁ + m₁ + (m₁ + m₁)) (m₁ + m₁) (κf (m₁ + m₁)) ⋯
SubsetMachine.no_decider_has_easyEven_char_log : ¬∃ M T lang,
    PallLean.Paper93.DeepMath.PathB.ComposableMachine.Decides M lang T ∧
      ∀ (m : ℕ),
        GodMoveSATSourceCanonicity.languageCharacteristic lang (m + m) = G4SATLink.easyEven (m + m) m (Nat.log 2 m) ⋯
SubsetMachine.easyEven_char_exists : ∀ (κ : ℕ),
  ∃ lang, ∀ (m : ℕ), GodMoveSATSourceCanonicity.languageCharacteristic lang (m + m) = G4SATLink.easyEven (m + m) m κ ⋯
def SubsetMachine.contMachine : PallLean.Paper93.DeepMath.PathB.ComposableMachine.Machine :=
{ State := SubsetMachine.CState, fin := inferInstance, dec := inferInstance, start := SubsetMachine.CState.readC,
  halt := fun s =>
    match s with
    | SubsetMachine.CState.done ans => Bool.true
    | x => Bool.false,
  δ := fun s b =>
    match s with
    | SubsetMachine.CState.readC =>
      if b = Bool.true then (SubsetMachine.CState.readX, Option.none, 1)
      else (SubsetMachine.CState.done Bool.true, Option.none, 2)
    | SubsetMachine.CState.readX => (SubsetMachine.CState.readY b, Option.none, 1)
    | SubsetMachine.CState.readY x =>
      if (b && !x) = Bool.true then (SubsetMachine.CState.done Bool.false, Option.none, 2)
      else (SubsetMachine.CState.readC, Option.none, 1)
    | SubsetMachine.CState.done a => (SubsetMachine.CState.done a, Option.none, 2),
  accept := fun s =>
    match s with
    | SubsetMachine.CState.done a => a
    | x => Bool.false }
def SubsetMachine.contLang : List Bool → Bool :=
fun x =>
  List.brecOn x fun x f =>
    (match (motive := (x : List Bool) → List.below x → Bool) x with
      | [] => fun x => Bool.true
      | Bool.false :: tail => fun x => Bool.true
      | [Bool.true] => fun x => Bool.true
      | [Bool.true, head] => fun x => Bool.true
      | Bool.true :: x :: y :: rest => fun x_1 => if (y && !x) = Bool.true then Bool.false else x_1.2.2.1)
      f
